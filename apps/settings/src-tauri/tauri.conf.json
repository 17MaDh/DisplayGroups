{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisplayGroups",
  "mainBinaryName": "displaygroups-settings",
  "version": "0.1.0",
  "identifier": "io.github.displaygroups.settings",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DisplayGroups",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "visible": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "DisplayGroups contributors",
    "copyright": "Copyright (c) 2026 DisplayGroups contributors",
    "icon": ["icons/icon.ico"]
  }
}
