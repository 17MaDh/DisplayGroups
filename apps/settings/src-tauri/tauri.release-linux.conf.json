{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Switch between groups of displays",
    "longDescription": "Organize monitors, TVs and projectors into groups and switch between them with a hotkey, a launcher or the tray. Uses GNOME's own display settings.",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "externalBin": ["binaries/displaygroups"],
    "resources": {
      "../../../locales/*.json": "locales/"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
