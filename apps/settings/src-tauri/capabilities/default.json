{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The settings window: core features plus showing itself and following the theme.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme"
  ]
}
